# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is gitignored.
#
# In production (Vercel): set each of these as a Project -> Settings ->
# Environment Variable instead, scoped to the "Production" environment (and
# "Preview" separately, with test/sandbox credentials, if preview
# deployments are used). Never paste real secrets into this file — it is
# committed to git and is a template only.

# --- Database (Phase 2) ---------------------------------------------------
# Standard mysql:// connection string, pointed at a natively-installed
# MySQL 8 server. This exact scheme matters: the Prisma CLI's migration
# engine expects "mysql://" (matching schema.prisma's `provider = "mysql"`),
# while the mariadb npm driver used at runtime only accepts its own
# "mariadb://" scheme in a raw connection string — so lib/db/prisma.ts
# parses this mysql:// URL into discrete host/port/user/password/database
# fields for the adapter rather than passing the string straight through.
# Keep this as mysql:// here; don't "fix" it to mariadb://.
# Local dev / staging / production each get their own value; this is a
# placeholder only. Use a dedicated low-privilege user for this database,
# not root — see README for the exact setup SQL.
# In production this must point at a managed MySQL server reachable from
# Vercel's serverless network (i.e. not "localhost" — Vercel functions
# don't run next to your database). See README's "Production deployment"
# section for connection requirements (public/allow-listed host, TLS).
DATABASE_URL="mysql://kwanomzi_app:password@localhost:3306/kwanomzi"

# --- Test database (Phase 4) -----------------------------------------------
# A SEPARATE database from DATABASE_URL above, used only by the automated
# test suite (tests/setup.ts). Keeps `npm test` from writing throwaway rows
# into the same database the dev server/demo uses — see the Phase 4 report
# for why this exists. Same host/user as DATABASE_URL is fine; only the
# database name needs to differ.
TEST_DATABASE_URL="mysql://kwanomzi_app:password@localhost:3306/kwanomzi_test"

# --- Auth (Phase 3) --------------------------------------------------------
# Required by Auth.js. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Yoco payments (Phase 4) ------------------------------------------------
# From your Yoco dashboard (Settings -> API Keys). Secret key authenticates
# server-to-server Checkout API calls; never expose it to the browser.
YOCO_SECRET_KEY=
# From registering a webhook (POST /api/webhooks) — see the Phase 4 report
# for the exact setup call. Starts with "whsec_". Used to verify every
# incoming webhook is genuinely from Yoco before trusting it.
YOCO_WEBHOOK_SECRET=
# Informational only (which key you're using already determines live vs
# test with Yoco) — used for our own logging, not sent to Yoco's API.
# Production still starts as YOCO_MODE=test with a test YOCO_SECRET_KEY
# until the business is ready to accept real payments — switching to a live
# key (and this to "live") is a deliberate later step, not part of initial
# deployment.
YOCO_MODE=test

# --- Email (Phase 4) ---------------------------------------------------------
# Resend (resend.com). RESEND_API_KEY from the Resend dashboard.
RESEND_API_KEY=
# Must be an address on a domain VERIFIED with Resend — you cannot send
# FROM a gmail.com address through a transactional provider. This is
# separate from kwanomzilodge@gmail.com, which stays the destination for
# staff notifications and is fine as-is for that purpose.
EMAIL_FROM=

# --- Application URL (Phase 4) ----------------------------------------------
# Used to build the Yoco checkout's successUrl/cancelUrl/failureUrl. No
# trailing slash. E.g. http://localhost:3000 in dev; in production this must
# be https://kwanomzilodge.co.za (set as the Vercel Production environment
# variable — do not hardcode it in code).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Internal endpoints (Phase 4) -------------------------------------------
# Shared secret guarding POST /api/internal/expire-holds (the booking hold
# expiry sweep) for manual/external-scheduler invocation via the
# `x-internal-secret` header. Generate with the same command as AUTH_SECRET
# above. Not used by Vercel Cron itself — see CRON_SECRET below.
INTERNAL_SWEEP_SECRET=

# Read automatically by Vercel: when this is set as a project environment
# variable, Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` on every
# request it makes to the schedule defined in vercel.json, and
# GET /api/internal/expire-holds checks it. Generate with the same command
# as AUTH_SECRET above. Irrelevant outside Vercel (e.g. local dev) — leave
# unset there.
CRON_SECRET=

# --- Database connection pool (production) ----------------------------------
# Per-instance connection pool size for the mariadb driver (see
# lib/db/prisma.ts). Optional — left unset here, which means the driver's
# own default (10) applies; that's fine for local dev/test against a single
# process. On Vercel, every concurrently warm serverless instance holds its
# own pool of this size, so set this explicitly in the Production
# environment (e.g. 3) if the database's max_connections needs a tighter
# cap under load. Leave unset in local/.env unless you're deliberately
# reproducing a production connection limit.
DATABASE_CONNECTION_LIMIT=
